# Runtime only. Real secrets never belong in Git, browser or Docker build args.
MODEL_API_BASE=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-5.6-luna
MODEL_KEY_FILE=./secrets/model.key
QUOTELENS_PORT=8765
APP_SEARCH_RUNS_DAY=12
APP_MODEL_CALLS_TOTAL=96
APP_MODEL_TOKENS_TOTAL=1500000
APP_MODEL_MICRO_USD_TOTAL=2000000
# Conservative micro-USD/token ceilings. Check before changing the fixed model.
MODEL_INPUT_MICRO_USD=1
MODEL_OUTPUT_MICRO_USD=5
